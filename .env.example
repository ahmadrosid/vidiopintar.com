# Local SQLite file, used when TURSO_DATABASE_URL is not set.
SQLITE_DATABASE_PATH=./data/vidiopintar.db

# Hosted Turso database (used in production). When set, it replaces the local SQLite file.
# TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Optional. Stabilizes server action IDs across deploys. Falls back to CLERK_SECRET_KEY.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Optional. When set, transcripts fall back to the Apify actor
# dami_studio/youtube-transcript-bulk-scraper when YouTube blocks direct fetches.
# APIFY_API_TOKEN=

# Local HTTPS (npm run setup:local && npm run dev:local):
# NEXT_PUBLIC_SITE_URL=https://vidiopintar.local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

ADMIN_MASTER_EMAIL=
